# Copy to backend/.env for local runs (never commit .env). In production set these as
# environment variables on the container host.

# Google Gemini API key (https://aistudio.google.com/apikey). Lives only on the backend.
GEMINI_API_KEY=
# Model ID. Checked 2026-10-10: gemini-3.8-flash and gemini-3.5-flash-lite are stable and
# support image/PDF input and structured output. Re-check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Shared token the app sends in X-App-Token. Weak protection (it can be extracted from the
# app), so also rely on the rate limits and the daily cap. Generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=change-me

# Max Gemini calls per UTC day (each retry counts). Per instance.
DAILY_GEMINI_CAP=200
# Max bill upload size in MB.
MAX_UPLOAD_MB=8

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_MINUTE=60
# EXTRACT_RATE_LIMIT_PER_MINUTE=10
# REQUEST_TIMEOUT_S=30
# EXTRACT_TIMEOUT_S=120
# GEMINI_CALL_TIMEOUT_S=45
# NASA_POWER_TIMEOUT_S=20
# Set true only behind a proxy you trust to set X-Forwarded-For (e.g. Cloud Run, Render).
# TRUST_PROXY_HEADERS=false
# Optional on-disk cache for NASA POWER climatology (not user data). Unset = memory only.
# NASA_CACHE_DIR=/tmp/nasa_power_cache
